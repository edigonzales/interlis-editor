{
  "private": true,
  "name": "interlis-editor-electron-app",
  "description": "INTERLIS Editor desktop application.",
  "productName": "INTERLIS Editor",
  "version": "0.1.0",
  "main": "scripts/theia-electron-main.js",
  "license": "MIT",
  "author": "INTERLIS Editor contributors",
  "homepage": "https://github.com/edigonzales/interlis-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edigonzales/interlis-editor.git"
  },
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22.0 <2"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "INTERLIS Editor",
        "reloadOnReconnect": true,
        "preferences": {
          "toolbar.showToolbar": true,
          "security.workspace.trust.enabled": false,
          "workbench.startupEditor": "welcomePage",
          "workbench.colorTheme": "Dark 2026",
          "editor.fontFamily": "JetBrains Mono, monospace",
          "terminal.integrated.fontFamily": "JetBrains Mono, monospace"
        },
        "electron": {
          "appUserModelId": "ch.interlis.editor",
          "showWindowEarly": false,
          "splashScreenOptions": {
            "content": "resources/interlis-splash.html",
            "height": 488,
            "width": 760,
            "minDuration": 750,
            "maxDuration": 30000
          }
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1,
        "startupTimeout": -1,
        "resolveSystemPlugins": false,
        "configurationFolder": ".interlis-editor"
      }
    },
    "generator": {
      "config": {
        "preloadTemplate": "./resources/preload.html"
      }
    }
  },
  "dependencies": {
    "@theia/bulk-edit": "1.74.0",
    "@theia/callhierarchy": "1.74.0",
    "@theia/console": "1.74.0",
    "@theia/core": "1.74.0",
    "@theia/debug": "1.74.0",
    "@theia/editor": "1.74.0",
    "@theia/editor-preview": "1.74.0",
    "@theia/electron": "1.74.0",
    "@theia/file-search": "1.74.0",
    "@theia/filesystem": "1.74.0",
    "@theia/getting-started": "1.74.0",
    "@theia/keymaps": "1.74.0",
    "@theia/markers": "1.74.0",
    "@theia/messages": "1.74.0",
    "@theia/mini-browser": "1.74.0",
    "@theia/monaco": "1.74.0",
    "@theia/navigator": "1.74.0",
    "@theia/outline-view": "1.74.0",
    "@theia/output": "1.74.0",
    "@theia/plugin-ext": "1.74.0",
    "@theia/plugin-ext-vscode": "1.74.0",
    "@theia/preferences": "1.74.0",
    "@theia/process": "1.74.0",
    "@theia/property-view": "1.74.0",
    "@theia/scm": "1.74.0",
    "@theia/search-in-workspace": "1.74.0",
    "@theia/secondary-window": "1.74.0",
    "@theia/task": "1.74.0",
    "@theia/terminal": "1.74.0",
    "@theia/toolbar": "1.74.0",
    "@theia/typehierarchy": "1.74.0",
    "@theia/userstorage": "1.74.0",
    "@theia/variable-resolver": "1.74.0",
    "@theia/vsx-registry": "1.74.0",
    "@theia/workspace": "1.74.0",
    "fs-extra": "9.1.0",
    "interlis-editor-product-ext": "0.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@theia/cli": "1.74.0",
    "app-builder-lib": "26.0.12",
    "electron": "42.3.0",
    "electron-builder": "26.15.3",
    "rimraf": "2.7.1"
  },
  "scripts": {
    "clean": "theia clean && rimraf node_modules dist",
    "build": "yarn -s rebuild && theia build --app-target=electron --mode development",
    "build:prod": "yarn -s rebuild && theia build --app-target=electron",
    "rebuild": "theia rebuild:electron --cacheRoot ../..",
    "start": "electron scripts/theia-electron-main.js",
    "package:preview": "rimraf dist && yarn rebuild && electron-builder --dir --linux",
    "package": "rimraf dist && yarn rebuild && electron-builder --publish never"
  }
}
